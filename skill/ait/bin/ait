#!/bin/sh
set -eu

SCRIPT_PATH=$0
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
SKILL_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' '{"ok":false,"code":"NODE_MISSING","error":"Node.js 22 or newer was not found on PATH."}'
  exit 1
fi

NODE_MAJOR=$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || printf '0')
case "$NODE_MAJOR" in
  ''|*[!0-9]*) NODE_MAJOR=0 ;;
esac
if [ "$NODE_MAJOR" -lt 22 ]; then
  printf '%s\n' '{"ok":false,"code":"NODE_VERSION_UNSUPPORTED","error":"Node.js 22 or newer is required."}'
  exit 1
fi

CORE_BIN=${AIT_CORE_BIN:-$SKILL_DIR/node_modules/ait-core/dist/src/bin.js}
if [ ! -f "$CORE_BIN" ]; then
  printf '%s\n' '{"ok":false,"code":"AIT_CORE_BIN_MISSING","error":"ait-core CLI bin was not found. Set AIT_CORE_BIN or install ait-core in the Skill directory."}'
  exit 1
fi

exec node "$CORE_BIN" "$@"
